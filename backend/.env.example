# Copy to .env and fill in. Never commit the real .env.
# This .example file must contain placeholders ONLY — no real secrets.

# ==============================================================================
# 1. Trading Mode & Working Capital
# ==============================================================================
# Mode: sandbox | live_approval | live_auto | backtest
#   - sandbox       : Paper trading against local IBKR paper gateway (auto-places)
#   - live_approval : Live account, orders queue on dashboard awaiting manual 1-click approval
#   - live_auto     : Live account, fully autonomous execution (opt-in)
#   - backtest      : Records planned trades without placing broker orders
TASTYAGENT_MODE=sandbox

# Working capital sizing mode:
# If true (default), size positions against custom TASTYAGENT_WORKING_CAPITAL.
# If false, size dynamically against connected IBKR account Total Cash (converted to USD).
TASTYAGENT_USE_CUSTOM_WORKING_CAPITAL=true

# Custom working capital to size against in USD (default: 10000.0).
# Used when TASTYAGENT_USE_CUSTOM_WORKING_CAPITAL=true.
TASTYAGENT_WORKING_CAPITAL=10000.0

# Scheduler cycle interval in seconds (default: 300, min: 30)
# TASTYAGENT_SCHEDULER_INTERVAL_SECONDS=300.0

# Only run scheduler during regular US market hours (default: true)
# TASTYAGENT_SCHEDULER_MARKET_HOURS_ONLY=true

# Automatically start trading scheduler on daemon launch (default: false)
# TASTYAGENT_AUTO_START_SCHEDULER=false

# Backend API server port (default: 3060)
TASTYAGENT_PORT=3060


# ==============================================================================
# 2. Interactive Brokers (IBKR) Gateway / TWS Connection
# ==============================================================================
# IBKR Sandbox (Paper Account) Gateway (default: 127.0.0.1:4002)
IBKR_SANDBOX_HOST=127.0.0.1
IBKR_SANDBOX_PORT=4002
IBKR_SANDBOX_CLIENT_ID=55

# IBKR Live (Real Account) Gateway (default: 127.0.0.1:4001, also supplies market data)
IBKR_LIVE_HOST=127.0.0.1
IBKR_LIVE_PORT=4001
IBKR_LIVE_CLIENT_ID=56

# Specific real account ID (e.g. U1234567).
# IMPORTANT: Only applies to real account live trading (live_approval / live_auto).
# In sandbox mode, IBKR_ACCOUNT is ignored and the connected paper trading gateway
# account is automatically used.
IBKR_ACCOUNT=

# Legacy aliases (supported for backward compatibility):
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=55
# IBKR_DATA_HOST=127.0.0.1
# IBKR_DATA_PORT=4001
# IBKR_DATA_CLIENT_ID=56

# ==============================================================================
# 3. Scheduler & Market Timing
# ==============================================================================
# Scheduler cycle interval in seconds (default: 300, min: 30)
# TASTYAGENT_SCHEDULER_INTERVAL_SECONDS=300.0

# Only run scheduler during regular US market hours (default: true)
# TASTYAGENT_SCHEDULER_MARKET_HOURS_ONLY=true

# Minutes after market open (9:30 ET) before making the first decision of the day (default: 15)
# Allows IV and bid-ask spreads to stabilize after opening bell
# TASTYAGENT_SCHEDULER_OPEN_DELAY_MINUTES=15

# Automatically start trading scheduler on daemon launch (default: false)
# TASTYAGENT_AUTO_START_SCHEDULER=false

# ==============================================================================
# 4. IBKR Market Scanner & Execution Settings
# ==============================================================================
# Market scanner code for high options volume stock universe
# Options: OPT_VOLUME_MOST_ACTIVE | HIGH_OPT_VOLUME_PUT_CALL_RATIO | MOST_ACTIVE
IBKR_SCAN_CODE=OPT_VOLUME_MOST_ACTIVE
IBKR_SCAN_ROWS=25

# Walk-the-book execution parameters (spread protection)
IBKR_WALK_STEP=0.01
IBKR_WALK_INTERVAL=5

# Pre-attached Take Profit order on opening BAG combos (50% max profit limit order)
IBKR_ATTACH_TP=true
IBKR_TP_PCT=0.50


# ==============================================================================
# 5. Adaptive LLM Layer (OpenRouter)
# ==============================================================================
# OpenRouter API key and model selection.
# Default model: deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional OpenRouter overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://github.com/swechencheng/IBTastyAgent
# OPENROUTER_APP_NAME=IBTastyAgent


# ==============================================================================
# 6. Optional Strategy Parameter Overrides (defaults in config.py apply if unset)
# ==============================================================================
# TASTYAGENT_MIN_IV_RANK=0.30             # Minimum IV rank threshold (0..1 fraction, e.g. 0.30 = 30%)
# TASTYAGENT_MIN_DTE=30                   # Minimum expiration days
# TASTYAGENT_MAX_DTE=55                   # Maximum expiration days
# TASTYAGENT_TARGET_DTE=45                # Target expiration days
# TASTYAGENT_MAX_SHORT_LEG_DELTA=0.25     # Absolute delta cap on any short leg
# TASTYAGENT_TARGET_SHORT_DELTA=0.18      # Target short delta (e.g. 0.18 for 18-delta)
# TASTYAGENT_SPREAD_LONG_DELTA=0.05       # Target delta for long wing on defined-risk spreads
# TASTYAGENT_MIN_CREDIT_WIDTH_RATIO=0.333 # 1/3 Strike Width rule: min net credit / spread width (33.3%)
# TASTYAGENT_UNIVERSE_TOP_N=15            # Number of top IVR names to analyze
# TASTYAGENT_MAX_BID_ASK_WIDTH_PCT=0.10   # Maximum (ask - bid) / mid ratio for liquidity filtering
# TASTYAGENT_MIN_OPEN_INTEREST=500        # Minimum open interest
# TASTYAGENT_MIN_DAILY_VOLUME=100         # Minimum daily option volume
# TASTYAGENT_EARNINGS_BLACKOUT_DAYS=7     # Days before earnings to avoid opening new positions
# TASTYAGENT_TAKE_PROFIT_PCT=0.50         # Take profit target fraction of max credit (50%)
# TASTYAGENT_MANAGE_DTE=21                # Roll out to next cycle when remaining DTE reaches this
# TASTYAGENT_USE_HARD_STOP=false          # Whether hard stop is enabled (default: false)
# TASTYAGENT_STOP_LOSS_MULTIPLE=2.0       # Stop loss multiple of credit (when use_hard_stop is true)


# ==============================================================================
# 7. Optional Risk Limit Overrides (defaults in config.py apply if unset)
# ==============================================================================
# TASTYAGENT_MIN_CUSHION_PCT=0.30         # Margin cushion guard: halt opening trades in live mode if cushion < 30%
# TASTYAGENT_MAX_TRADE_BP_PCT=0.05        # Max buying-power reduction per trade vs net liq (5%)
# TASTYAGENT_MAX_TOTAL_BP_PCT=0.40        # Max aggregate buying-power usage vs net liq (40%)
# TASTYAGENT_MAX_POSITIONS=15             # Maximum concurrent open positions
# TASTYAGENT_MAX_POSITIONS_PER_SYMBOL=2   # Maximum concurrent positions per underlying
# TASTYAGENT_MAX_DAILY_LOSS_PCT=0.03      # Daily realized loss threshold to halt entries (3%)
# TASTYAGENT_CONSECUTIVE_LOSS_HALT=5      # Halt entries after N consecutive losing trades
# TASTYAGENT_KILL_SWITCH=false            # Hard stop on all new orders
